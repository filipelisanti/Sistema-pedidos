# Copiar a .env y ajustar
DATABASE_URL="postgresql://pedidos:pedidos@localhost:5432/pedidos"
# Base que usan los tests de integración (se vacía en cada corrida, nunca apuntar a la de desarrollo)
DATABASE_URL_TEST="postgresql://pedidos:pedidos@localhost:5432/pedidos_test"
PORT=3000
# Origen del frontend (CORS)
WEB_ORIGIN="http://localhost:5173"

# Usuario superadmin que crea el seed (cambiar en producción)
SEED_SUPERADMIN_EMAIL="admin@pedidos.local"
SEED_SUPERADMIN_PASSWORD="cambiar-esta-clave"
